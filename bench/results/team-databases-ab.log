# team-databases — H8-A: build the columnar frame in place
#
# Same host, same command, one player at a time, under /tmp/fpq-bench.lock.
# Baseline image: fpq-baseline. Change image: fpq-databases (team/databases).
#
# command:
#   flock /tmp/fpq-bench.lock -c 'docker run --rm --shm-size=3g \
#       -e BENCH_GIT_REV=baseline fpq-baseline benchmarks.sh 100000'
#   flock /tmp/fpq-bench.lock -c 'docker run --rm --shm-size=3g \
#       -e BENCH_GIT_REV=databases fpq-databases benchmarks.sh 100000'

