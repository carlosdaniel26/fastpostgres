heap.stream.ms: 11.359
heap.stream.faults: 0 0
columnar.load.ms: 11.993
columnar.load.faults: 3 0
columnar.bytes: 3877790
columnar.heap.x: 0.507
columnar.scan.cold.ms: 0.790
columnar.scan.cold.faults: 1 0
verify.reduce: ok
columnar.scan.rows_s: 127340032
columnar.scan.ms: 0.785
