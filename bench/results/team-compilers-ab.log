mem: 30 GiB
ghz: 3.8
cores: 8
postgres: 18.6
python: 3.13.5
sqlalchemy: 2.0.40
pyarrow: 26.0.0
adbc: 1.13.0
shape: bench
git: baseline
shm: 3.0G
### END ENV

