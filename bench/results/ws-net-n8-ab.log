### Reproduce

    docker build -q --target dev -t fpq-net-n8 -f docker/Dockerfile .
    docker run --rm --shm-size=3g -e FASTPOSTGRES_TRANSPORT=eventfd \
      -v "$PWD/bench/internals/threads/ring_scaling.py:/tmp/ring_scaling.py:ro" \
      fpq-net-n8 python3 /tmp/ring_scaling.py --rows 100000 --reads 3 --reps 5
    # and the lever:
    docker run --rm --shm-size=3g -e FASTPOSTGRES_TRANSPORT=eventfd \
      -e PG_OPTS='-c max_worker_processes=16' \
      -v "$PWD/bench/internals/threads/ring_scaling.py:/tmp/ring_scaling.py:ro" \
      fpq-net-n8 python3 /tmp/ring_scaling.py --rows 100000 --reads 3 --reps 5
