map-batch: size=small rows=3000 batches=100 worker_ns_per_row=104.53 worker_rows_per_s=9.57M worker_cpu_ns_per_row=97.92 client_ns_per_row=86.53 total_ns_per_row=191.06 total_rows_per_s=5.23M
map-batch: size=control rows=100000 batches=5 worker_ns_per_row=36.73 worker_rows_per_s=27.23M worker_cpu_ns_per_row=44.71 client_ns_per_row=287.14 total_ns_per_row=323.87 total_rows_per_s=3.09M
### run 2
map-batch: size=small rows=3000 batches=100 worker_ns_per_row=106.61 worker_rows_per_s=9.38M worker_cpu_ns_per_row=97.66 client_ns_per_row=87.72 total_ns_per_row=194.33 total_rows_per_s=5.15M
map-batch: size=control rows=100000 batches=5 worker_ns_per_row=39.94 worker_rows_per_s=25.03M worker_cpu_ns_per_row=44.60 client_ns_per_row=287.80 total_ns_per_row=327.74 total_rows_per_s=3.05M
### run 3
map-batch: size=small rows=3000 batches=100 worker_ns_per_row=111.50 worker_rows_per_s=8.97M worker_cpu_ns_per_row=105.02 client_ns_per_row=86.99 total_ns_per_row=198.49 total_rows_per_s=5.04M
map-batch: size=control rows=100000 batches=5 worker_ns_per_row=37.87 worker_rows_per_s=26.41M worker_cpu_ns_per_row=44.15 client_ns_per_row=287.39 total_ns_per_row=325.26 total_rows_per_s=3.07M
