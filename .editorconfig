root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{c,h,cpp,hpp}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# the documents are hand-wrapped: trailing spaces are markdown line breaks
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[Makefile]
indent_style = tab
