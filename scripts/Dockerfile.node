# postgres:18 + Node, with the extension installed and the Node addon built.
# Shared by scripts/test-pg-docker.sh, bench-node-docker.sh and profile.sh.
FROM postgres:18
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential postgresql-server-dev-18 python3 nodejs npm \
 && rm -rf /var/lib/apt/lists/*
COPY pg-extension /src/pg-extension
COPY node-extension /src/node-extension
COPY benchmark /src/benchmark
WORKDIR /src/pg-extension
RUN make clean && make && make install
WORKDIR /src/node-extension
RUN npm install --no-audit --no-fund && npm run build
