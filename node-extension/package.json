{
  "name": "nativepostgress",
  "version": "1.0.0",
  "private": true,
  "description": "Node client for nativepostgress: columnar query results over POSIX shared memory, delivered as zero-copy JS typed arrays",
  "keywords": [
    "postgresql",
    "postgres",
    "shared-memory",
    "columnar",
    "typed-arrays",
    "zero-copy",
    "napi",
    "native-addon"
  ],
  "license": "UNLICENSED",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib/",
    "src/",
    "binding.gyp"
  ],
  "gypfile": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
